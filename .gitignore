# =============================================================================
# .gitignore for a Python (uv) + LangChain project
#
# COMMITTED on purpose (do NOT add these here):
#   pyproject.toml, uv.lock, .python-version, requirements.txt, .env.example
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets & environment variables  (API keys: OpenAI, Groq, Google, ...)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
.envrc
secrets/
*.secret
*.pem
*.key
credentials.json
service-account*.json
client_secret*.json


# -----------------------------------------------------------------------------
# Virtual environments (uv creates .venv/)
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.virtualenv/
.pdm-python
.pdm-build/
__pypackages__/


# -----------------------------------------------------------------------------
# Python bytecode & build artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-wheel-metadata/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt


# -----------------------------------------------------------------------------
# Testing, coverage & type checking / linting caches
# -----------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover
*.py,cover
.hypothesis/
.cache/

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/


# -----------------------------------------------------------------------------
# Jupyter / IPython (common for LangChain experiments)
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py


# -----------------------------------------------------------------------------
# LangChain / LangGraph / LLM tooling
# -----------------------------------------------------------------------------
# LangChain SQLite LLM cache (set_llm_cache(SQLiteCache(...)))
.langchain.db
*.langchain.db

# LangGraph CLI / dev server local state
.langgraph_api/

# Local vector stores & embedding indexes
chroma/
chroma_db/
.chroma/
faiss_index/
*.faiss
*.pkl
lancedb/
.lancedb/
qdrant_storage/
vectorstore/
vector_store/

# Local model weights & Hugging Face cache
models/
*.gguf
*.bin
*.safetensors
.huggingface/

# Local databases & checkpointers
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm


# -----------------------------------------------------------------------------
# Logs, temp & runtime files
# -----------------------------------------------------------------------------
logs/
*.log
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.pid


# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
# VS Code: ignore personal settings, keep shareable ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.history/

# JetBrains (PyCharm)
.idea/

# Others
.spyderproject
.spyproject
.ropeproject
*.sublime-project
*.sublime-workspace


# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*
.nfs*


# -----------------------------------------------------------------------------
# AI coding assistants (local, per-user state)
# -----------------------------------------------------------------------------
.claude/settings.local.json
